/* pages/index/index.wxss —— 占位页，用定稿 token，避免项目看起来像模板 */
.home {
  padding-top: 48rpx;
}

.home__meta {
  font-size: 24rpx;
  color: var(--ink-3);
  letter-spacing: .02em;
}

.home__hero {
  padding: 72rpx 0 56rpx;
}

.home__label {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -.01em;
}

.home__hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.home__list {
  padding-top: 16rpx;
}

.home__item {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.home__idx {
  width: 48rpx;
  font-size: 26rpx;
  color: var(--ink-3);
}

.home__name {
  font-size: 30rpx;
}
