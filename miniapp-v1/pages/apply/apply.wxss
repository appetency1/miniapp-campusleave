/* pages/apply/apply.wxss —— 页面级样式（前缀 ap__），仅复用全局令牌与组件类 */

.ap__head { padding: 40rpx 0 6rpx; }
.ap__eyebrow { display: block; margin-bottom: 16rpx; }
.ap__intro { margin-top: 22rpx; }
.ap__rule { display: block; margin-top: 14rpx; line-height: 1.6; }
.ap__cur { margin-top: 12rpx; }

.ap__form { margin-top: 28rpx; }

/* 表单字段：以字段为单位画分隔线，行本身不再重复画线 */
.ap__field { border-bottom: 2rpx solid var(--line); }
.ap__field:last-child { border-bottom: none; }
.ap__row--bare { border-bottom: none; }
.ap__row--top { padding-bottom: 6rpx; }
.ap__err { display: block; padding: 0 0 22rpx; font-size: 23rpx; line-height: 1.45; color: var(--clay); }

.ap__pick { display: flex; align-items: center; min-height: 44rpx; color: var(--ink); font-size: 28rpx; }
.ap__pick--ph { color: var(--ink-3); }
.ap__pick--box {
  padding: 12rpx 20rpx;
  background: var(--paper);
  border-radius: var(--r-sm);
  font-size: 27rpx;
}
.ap__times { display: flex; align-items: center; gap: 16rpx; }

.ap__input {
  flex: 1;
  min-height: 44rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--ink);
}

.ap__ta {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  margin-top: 6rpx;
  padding: 24rpx;
  background: var(--paper);
  border-radius: var(--r-md);
  font-size: 28rpx;
  line-height: 1.6;
}
.ap__ph { color: var(--ink-3); }
.ap__count { display: block; text-align: right; padding-bottom: 20rpx; }

.ap__chip-press { opacity: 0.72; }

.ap__submit { margin-top: 44rpx; padding-top: 8rpx; }
.ap__press { opacity: 0.82; transform: translateY(2rpx); }
.ap__hint { display: block; text-align: center; margin-top: 22rpx; }
