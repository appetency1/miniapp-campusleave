/* pages/index/index.wxss —— 旗舰首页（页面前缀 home__，仅复用 app.wxss 令牌/组件类） */

.home {
  min-height: 100vh;
  padding-bottom: 72rpx;
}

/* ---------- hero ---------- */
.home__hero {
  position: relative;
  width: 100%;
  height: 620rpx;
  overflow: hidden;
  background: var(--moss);
}
.home__hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 620rpx;
  display: block;
}
.home__veil {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg,
    rgba(31, 58, 43, 0) 0%,
    rgba(31, 58, 43, 0.30) 36%,
    rgba(31, 58, 43, 0.62) 68%,
    rgba(31, 58, 43, 0.92) 88%,
    rgba(244, 242, 234, 1) 100%);
}

/* ---------- 自定义导航 ---------- */
.home__nav {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 3;
  box-sizing: border-box;
  padding-left: var(--pad);
  padding-right: var(--pad);
  padding-bottom: 14rpx;
  display: flex;
  align-items: flex-end;
}
.home__brand {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: #F6F5EF;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.30);
}

/* ---------- 照片上的问候 ---------- */
.home__greet {
  position: absolute;
  left: var(--pad);
  right: var(--pad);
  bottom: 140rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
}
.home__hi {
  color: #F7F6F0;
  text-shadow: 0 4rpx 20rpx rgba(20, 38, 28, 0.55);
}
.home__sub {
  margin-top: 16rpx;
  color: rgba(247, 246, 240, 0.88);
  text-shadow: 0 2rpx 12rpx rgba(20, 38, 28, 0.50);
}

/* ---------- 内容区 ---------- */
.home__main {
  position: relative;
  padding: 0 var(--pad);
}

/* 状态卡上浮 */
.home__focus {
  position: relative;
  z-index: 4;
  margin-top: -72rpx;
}
.home__focus-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home__cap {
  display: block;
  margin-top: 34rpx;
}
.home__count {
  display: block;
  margin-top: 12rpx;
  font-size: 80rpx;
  font-weight: 900;
  line-height: 1.06;
  letter-spacing: -2rpx;
  color: var(--moss);
  white-space: nowrap;
}
.home__meta {
  display: block;
  margin-top: 16rpx;
}
.home__acts {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
}
.home__acts .btn--primary {
  flex: 1;
}
.home__acts .btn--ghost {
  flex: none;
  margin-left: 18rpx;
}
.home__pressed {
  opacity: 0.74;
  transform: translateY(2rpx);
}

/* ---------- 记录区 ---------- */
.home__section {
  margin-top: 56rpx;
}
.home__sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.home__filter {
  margin-top: 24rpx;
}
.home__list {
  margin-top: 6rpx;
}
.home__row-hover {
  background: rgba(31, 58, 43, 0.04);
}
.home__skel-line {
  height: 30rpx;
  width: 58%;
}
.home__skel-line--sm {
  height: 22rpx;
  width: 40%;
  margin-top: 14rpx;
}
.home__skel-pill {
  width: 128rpx;
  height: 44rpx;
  border-radius: 999rpx;
  flex: none;
}
