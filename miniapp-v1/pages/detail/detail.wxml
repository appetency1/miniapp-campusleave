<!-- pages/detail/detail.wxml —— 申请详情 -->
<view class="page page--paper safe-bottom">

  <!-- loading 骨架 -->
  <block wx:if="{{loading}}">
    <view class="dt__skelHero skel"></view>
    <view class="card--flat dt__skelCard">
      <view class="skel dt__skelLine" style="width:32%"></view>
      <view class="skel dt__skelLine" style="width:78%; margin-top:22rpx"></view>
      <view class="skel dt__skelLine" style="width:58%; margin-top:22rpx"></view>
    </view>
    <view class="card--flat dt__skelCard">
      <view class="skel dt__skelLine" style="width:24%"></view>
      <view class="skel dt__skelLine" style="width:88%; margin-top:22rpx"></view>
      <view class="skel dt__skelLine" style="width:66%; margin-top:22rpx"></view>
      <view class="skel dt__skelLine" style="width:74%; margin-top:22rpx"></view>
    </view>
  </block>

  <view class="empty" wx:elif="{{error}}">
    <view class="empty__mark"></view>
    <view class="empty__title">申请加载失败</view>
    <view class="empty__desc">{{error}}</view>
    <button class="btn btn--ghost btn--sm dt__retry" hover-class="dt__press" bindtap="load">重新加载</button>
  </view>

  <block wx:else>

    <!-- 状态块 -->
    <view class="dt__hero reveal" style="--d:0s">
      <view class="dt__heroTop">
        <text class="dt__heroNo t-cap">编号 <text class="t-num">{{detail.no}}</text></text>
        <view class="pill pill--{{detail.pillKind}} {{detail.breath ? 'pill--breath' : ''}}">
          <view class="pill__dot"></view>{{detail.statusLabel}}
        </view>
      </view>
      <view class="dt__heroStatus t-display">{{detail.statusLabel}}</view>
      <view class="dt__heroPeriod t-num">{{detail.period}}</view>
    </view>

    <!-- 状态时间线 -->
    <view class="card--flat dt__tl reveal" style="--d:.05s" wx:if="{{detail.logs.length}}">
      <text class="t-cap">状态时间线</text>
      <view class="dt__tlList">
        <view class="dt__tlItem" wx:for="{{detail.logs}}" wx:key="k">
          <view class="dt__tlAxis">
            <view class="dt__tlDot {{index === detail.logs.length - 1 ? 'dt__tlDot--on' : ''}}"></view>
            <view class="dt__tlLine" wx:if="{{index < detail.logs.length - 1}}"></view>
          </view>
          <view class="dt__tlBody">
            <view class="dt__tlLabel t-h2">{{item.label}}</view>
            <view class="dt__tlMeta t-meta"><text class="t-num">{{item.atText}}</text> · {{item.by}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 信息卡 -->
    <view class="card--flat dt__info reveal" style="--d:.1s">
      <text class="t-cap">申请信息</text>
      <view class="dt__rows">
        <view class="row">
          <view class="row__main"><text class="row__sub">请假场景</text></view>
          <text class="t-body">{{detail.sceneText}}</text>
        </view>
        <view class="row">
          <view class="row__main"><text class="row__sub">请假类型</text></view>
          <text class="t-body">{{detail.type}}</text>
        </view>
        <view class="row dt__rowStack">
          <view class="row__main"><text class="row__sub">请假事由</text></view>
          <text class="t-body dt__stackVal">{{detail.reason}}</text>
        </view>
        <view class="row" wx:if="{{detail.destination}}">
          <view class="row__main"><text class="row__sub">去向</text></view>
          <text class="t-body">{{detail.destination}}</text>
        </view>
        <view class="row">
          <view class="row__main"><text class="row__sub">联系电话</text></view>
          <text class="t-body t-num">{{detail.phone}}</text>
        </view>
        <view class="row">
          <view class="row__main"><text class="row__sub">提交时间</text></view>
          <text class="t-body t-num">{{detail.submittedAt}}</text>
        </view>
        <view class="row" wx:if="{{detail.approvedBy}}">
          <view class="row__main"><text class="row__sub">审批人</text></view>
          <text class="t-body">{{detail.approvedBy}}</text>
        </view>
        <view class="row" wx:if="{{detail.approvedAt}}">
          <view class="row__main"><text class="row__sub">审批时间</text></view>
          <text class="t-body t-num">{{detail.approvedAt}}</text>
        </view>
        <view class="row" wx:if="{{detail.actualEndTime}}">
          <view class="row__main"><text class="row__sub">实际结束</text></view>
          <text class="t-body t-num">{{detail.actualEndTime}}</text>
        </view>
      </view>
    </view>

    <!-- 驳回原因 -->
    <view class="dt__reject reveal" style="--d:.14s" wx:if="{{detail.rejectReason}}">
      <text class="t-cap dt__rejectCap">驳回原因</text>
      <view class="t-body dt__rejectText">{{detail.rejectReason}}</view>
    </view>

    <!-- 取消原因 -->
    <view class="dt__reject dt__cancel reveal" style="--d:.16s" wx:if="{{detail.cancelReason}}">
      <text class="t-cap dt__cancelCap">取消原因</text>
      <view class="t-body dt__cancelText">{{detail.cancelReason}}</view>
    </view>

    <!-- 操作区 -->
    <view class="dt__actions reveal" style="--d:.18s">
      <button class="btn btn--primary dt__act" wx:if="{{detail.canCheckin}}"
        hover-class="dt__press" bindtap="onCheckin">返校定位销假</button>
      <button class="btn btn--primary dt__act" wx:if="{{detail.canExtend}}"
        hover-class="dt__press" bindtap="onExtend">续假申请</button>
      <button class="btn btn--ghost dt__act" wx:if="{{detail.canWithdraw}}"
        hover-class="dt__press" bindtap="onWithdraw">撤回申请</button>
      <button class="btn btn--ghost dt__act" wx:if="{{detail.canCancel}}"
        hover-class="dt__press" bindtap="onCancel">取消申请</button>
    </view>

  </block>

</view>
