/* pages/detail/detail.wxss —— 页面级样式（前缀 dt__） */

/* ---------- 骨架 ---------- */
.dt__skelHero { margin-top: 32rpx; height: 300rpx; border-radius: var(--r-lg); }
.dt__skelCard { margin-top: 28rpx; }
.dt__skelLine { height: 26rpx; border-radius: var(--r-sm); }

/* ---------- 状态块 ---------- */
.dt__hero {
  margin-top: 32rpx;
  padding: 40rpx 36rpx 44rpx;
  background: var(--moss);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-lg);
}
.dt__heroTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.dt__heroNo { color: rgba(244, 242, 234, 0.6); }
.dt__heroNo .t-num { color: rgba(244, 242, 234, 0.92); }
.dt__heroStatus { margin-top: 28rpx; color: #FBF9F2; }
.dt__heroPeriod { margin-top: 14rpx; font-size: 26rpx; color: rgba(244, 242, 234, 0.78); }

/* ---------- 时间线 ---------- */
.dt__tl { margin-top: 28rpx; }
.dt__tlList { margin-top: 26rpx; }
.dt__tlItem { display: flex; }
.dt__tlAxis {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dt__tlDot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--line-2);
  flex: none;
  margin-top: 12rpx;
}
.dt__tlDot--on {
  background: var(--moss);
  box-shadow: 0 0 0 8rpx rgba(31, 58, 43, 0.12);
}
.dt__tlLine { flex: 1; width: 2rpx; background: var(--line); margin: 8rpx 0; }
.dt__tlBody { flex: 1; min-width: 0; padding: 0 0 34rpx 16rpx; }
.dt__tlItem:last-child .dt__tlBody { padding-bottom: 4rpx; }
.dt__tlLabel { font-size: 30rpx; }
.dt__tlMeta { margin-top: 8rpx; }

/* ---------- 信息卡 ---------- */
.dt__info { margin-top: 28rpx; }
.dt__rows { margin-top: 18rpx; }
.dt__rowStack { flex-direction: column; align-items: flex-start; }
.dt__stackVal { display: block; margin-top: 12rpx; line-height: 1.6; }

/* ---------- 驳回 / 取消 ---------- */
.dt__reject {
  margin-top: 24rpx;
  padding: 26rpx 30rpx;
  background: var(--clay-soft);
  border-left: 8rpx solid var(--clay);
  border-radius: var(--r-md);
}
.dt__rejectCap { color: var(--clay); }
.dt__rejectText { margin-top: 10rpx; color: #7A3E26; }
.dt__cancel { background: #EFEDE2; border-left-color: var(--ink-2); }
.dt__cancelCap { color: var(--ink-2); }
.dt__cancelText { margin-top: 10rpx; color: var(--ink-2); }

/* ---------- 操作区 ---------- */
.dt__actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.dt__press { opacity: 0.82; transform: translateY(2rpx); }
.dt__retry { display: inline-block; margin-top: 26rpx; }
