/* pages/records/records.wxss —— 记录页（页面前缀 rec__） */

.rec {
  padding-top: 36rpx;
}
.rec__cap {
  display: block;
  margin-bottom: 20rpx;
}

/* ---------- KPI ---------- */
.rec__kpi {
  display: flex;
  align-items: center;
  padding: 36rpx 10rpx;
}
.rec__kpi-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.rec__kpi-item + .rec__kpi-item {
  border-left: 2rpx solid var(--line);
}
.rec__kpi-num {
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.1;
  color: var(--moss);
}
.rec__kpi-label {
  margin-top: 10rpx;
}

/* ---------- 筛选与列表 ---------- */
.rec__filter {
  margin-top: 34rpx;
}
.rec__list {
  margin-top: 6rpx;
}
.rec__row-hover {
  background: rgba(31, 58, 43, 0.04);
}
.rec__skel-line {
  height: 30rpx;
  width: 58%;
}
.rec__skel-line--sm {
  height: 22rpx;
  width: 40%;
  margin-top: 14rpx;
}
.rec__skel-pill {
  width: 128rpx;
  height: 44rpx;
  border-radius: 999rpx;
  flex: none;
}
