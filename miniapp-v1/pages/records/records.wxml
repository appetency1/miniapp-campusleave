<!-- pages/records/records.wxml —— 请假记录（KPI + 胶囊筛选 + 列表） -->
<view class="page page--paper safe-bottom rec">

  <text class="t-cap rec__cap reveal">本学期 · 概览</text>

  <!-- KPI：申请数 / 审批通过 / 已完成 / 当前逾期 -->
  <view class="card rec__kpi reveal" style="--d:.05s">
    <view class="rec__kpi-item" wx:for="{{kpis}}" wx:key="key">
      <text class="t-num rec__kpi-num {{item.clay ? 't-clay' : ''}}">{{item.value}}</text>
      <text class="t-cap rec__kpi-label">{{item.label}}</text>
    </view>
  </view>

  <view class="chips rec__filter reveal" style="--d:.1s">
    <view wx:for="{{filters}}" wx:key="key" class="chip {{filter === item.key ? 'chip--on' : ''}}" data-key="{{item.key}}" bindtap="onFilter">
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 首帧骨架 -->
  <view wx:if="{{loading}}" class="rec__list">
    <view wx:for="{{[0, 1, 2]}}" wx:key="*this" class="row">
      <view class="row__main">
        <view class="skel rec__skel-line"></view>
        <view class="skel rec__skel-line rec__skel-line--sm"></view>
      </view>
      <view class="skel rec__skel-pill"></view>
    </view>
  </view>

  <view wx:elif="{{shown.length}}" class="rec__list">
    <view wx:for="{{shown}}" wx:key="id" class="row reveal" style="--d:{{item.d}}" hover-class="rec__row-hover" data-id="{{item.id}}" bindtap="onItem">
      <view class="row__main">
        <view class="row__title">{{item.type}} · {{item.sceneText}}</view>
        <view class="row__sub">{{item.period}} · {{item.statusLabel}}</view>
      </view>
      <view class="pill pill--{{item.pillKind}}">
        <view class="pill__dot"></view>
        <text>{{item.statusLabel}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty__mark"></view>
    <view class="empty__title">暂无相关记录</view>
    <view class="empty__desc">换个筛选条件看看</view>
  </view>
</view>
