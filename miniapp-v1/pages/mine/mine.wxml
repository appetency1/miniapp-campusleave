<!-- pages/mine/mine.wxml —— 我的 -->
<view class="page page--paper safe-bottom mine">

  <!-- 个人卡 -->
  <view class="card card--lift mine__profile reveal" style="--d:.05s">
    <view class="mine__avatar">{{student.avatarText}}</view>
    <view class="mine__id">
      <text class="t-h1">{{student.name}}</text>
      <text class="t-meta mine__sid">{{student.sid}} · {{student.className}}</text>
    </view>
  </view>

  <!-- 信息卡 -->
  <view class="mine__section reveal" style="--d:.1s">
    <text class="t-cap mine__cap">学籍信息</text>
    <view class="card mine__info">
      <view class="row">
        <text class="mine__k">学院</text>
        <text class="t-meta mine__v">{{student.college}}</text>
      </view>
      <view class="row">
        <text class="mine__k">班级</text>
        <text class="t-meta mine__v">{{student.className}}</text>
      </view>
      <view class="row">
        <text class="mine__k">辅导员</text>
        <text class="t-meta mine__v">{{student.counselor}}</text>
      </view>
      <view class="row">
        <text class="mine__k">手机号</text>
        <text class="t-meta mine__v">{{student.phone}}</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="mine__section reveal" style="--d:.15s">
    <text class="t-cap mine__cap">账户与设置</text>
    <view class="card mine__menu">
      <view class="row" hover-class="mine__cell-hover" bindtap="onNotice">
        <text class="row__title">消息通知</text>
        <view class="mine__cell-right">
          <view wx:if="{{notice.unread}}" class="mine__badge">{{notice.unread}}</view>
          <view class="chev"></view>
        </view>
      </view>
      <view class="row" hover-class="mine__cell-hover" bindtap="onAbout">
        <text class="row__title">关于系统</text>
        <view class="mine__cell-right">
          <view class="chev"></view>
        </view>
      </view>
      <view class="row" hover-class="mine__cell-hover" bindtap="onLogout">
        <text class="row__title">退出登录</text>
        <view class="mine__cell-right">
          <view class="chev"></view>
        </view>
      </view>
    </view>
  </view>
</view>
