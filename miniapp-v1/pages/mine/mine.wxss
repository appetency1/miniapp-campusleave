/* pages/mine/mine.wxss —— 我的（页面前缀 mine__） */

.mine {
  padding-top: 40rpx;
}

/* ---------- 个人卡 ---------- */
.mine__profile {
  display: flex;
  align-items: center;
}
.mine__avatar {
  flex: none;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--moss);
  color: #F6F5EF;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 132rpx;
  text-align: center;
}
.mine__id {
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.mine__sid {
  margin-top: 14rpx;
}

/* ---------- 分区 ---------- */
.mine__section {
  margin-top: 48rpx;
}
.mine__cap {
  display: block;
  margin-bottom: 20rpx;
}

/* ---------- 信息卡 ---------- */
.mine__info {
  padding: 0 34rpx;
}
.mine__k {
  font-size: 28rpx;
  color: var(--ink-2);
}
.mine__v {
  text-align: right;
}

/* ---------- 功能列表 ---------- */
.mine__menu {
  padding: 0 34rpx;
}
.mine__cell-right {
  display: flex;
  align-items: center;
  flex: none;
}
.mine__cell-hover {
  background: rgba(31, 58, 43, 0.04);
}
.mine__badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--moss);
  color: #F6F5EF;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}
