spring:
  datasource:
    url: jdbc:mysql://localhost:3306/campus_leave?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: 请填写你的 MySQL root 密码
    driver-class-name: com.mysql.cj.jdbc.Driver
  jackson:
    time-zone: Asia/Shanghai
    date-format: yyyy-MM-dd HH:mm:ss

campus-leave:
  jwt:
    # 生产环境请替换为随机长串（>= 32 字节）
    secret: campus-leave-jwt-secret-key-change-me-2026
    expire-seconds: 604800   # 7 天
  upload:
    dir: uploads
  mock-location: false
