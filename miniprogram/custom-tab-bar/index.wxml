<!--
  custom-tab-bar/index.wxml

  结构：图标（内联 base64 SVG）+ 文字。选中项图标与文字同时变墨色、文字加粗。
  图标两版色值（off #8E887B / on #15202E）都打包在 icons.js 里，
  切换时只换 src，不用 CSS filter —— 小程序对 filter 支持不稳定。
-->
<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'tab--on' : ''}}"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view class="tab__wrap">
      <image
        class="tab__i"
        src="{{selected === index ? item.iconOn : item.iconOff}}"
        mode="aspectFit"
      />
      <!-- 消息未读角标 -->
      <view wx:if="{{index === 2 && unread > 0}}" class="tab__badge num">
        {{unread > 99 ? '99+' : unread}}
      </view>
    </view>
    <text class="tab__t">{{item.text}}</text>
  </view>
</view>
