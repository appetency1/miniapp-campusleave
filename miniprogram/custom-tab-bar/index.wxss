/* custom-tab-bar/index.wxss
 * 纸感 tabBar：纸底 + 顶部 1rpx 细线 + 文字 + 选中蓝线
 * 触控高度 104rpx（≈52px），满足 ≥44px 的触控目标要求
 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--paper, #FBFAF7);
  /* 顶部细线，替代阴影 —— 定稿的原则是只用 1px 线分区 */
  border-top: 1rpx solid var(--line, #E7E3D9);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab__wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab__t {
  font-size: 26rpx;
  line-height: 1;
  letter-spacing: 0.04em;
  /* 未选中：墨色 3 号（偏灰），选中：纯墨 */
  color: var(--ink-3, #6B6559);
  transition: color 0.2s ease;
}

.tab--on .tab__t {
  color: var(--ink, #15202E);
  font-weight: 600;
}

/* 选中态短横线：默认透明，选中时变蓝并略微上浮 */
.tab__bar {
  width: 28rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: transparent;
  transition: background 0.2s ease, transform 0.2s ease;
  transform: translateY(-2rpx);
}

.tab--on .tab__bar {
  background: var(--blue-500, #2563C9);
  transform: translateY(0);
}

/* 未读角标 */
.tab__badge {
  font-family: "Noto Serif SC", "Songti SC", Georgia, serif;
  font-variant-numeric: tabular-nums;
  position: absolute;
  left: 100%;
  top: -10rpx;
  margin-left: 2rpx;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 6rpx;
  border-radius: 13rpx;
  background: var(--red-600, #B23A28);
  color: #fff;
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
}
