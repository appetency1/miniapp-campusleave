/* custom-tab-bar/index.wxss
 * 纸感 tabBar：纸底 + 顶部 1rpx 细线 + 线性图标 + 文字
 *
 * ── 安全区自适应 ──
 * 不同机型底部留白不一样，只能靠 env(safe-area-inset-bottom) 拿，不能按机型写死：
 *    iPhone X 及之后（灵动岛/刘海）  → 34pt
 *    iPhone SE / 8 等无手势条机型   → 0
 *    Android 三键虚拟导航            → 0（微信客户端已把窗口排掉了导航栏，无需再留）
 *    Android 全面屏手势条            → 部分机型返回非 0，部分返回 0
 * 所以：留白交给 env()，高度只写最小值，内容自己撑开。
 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  /* 小程序 WXSS 没有全局 border-box reset。不写这一行，min-height 里已含的 safe-area
     会再叠一份 padding-bottom，总高多出一整个安全区 → 文字被顶到偏上。 */
  box-sizing: border-box;
  /* 用 min-height 而不是 height：字号再调、或系统字体放大时，tab 内容不会被压扁 */
  min-height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--paper, #FBFAF7);
  /* 顶部细线，替代阴影 —— 定稿的原则是只用 1px 线分区 */
  border-top: 1rpx solid var(--line, #E7E3D9);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

/* 图标容器：固定 44rpx 高，选中/未选中切换只换 src，不改变盒子尺寸（避免跳动） */
.tab__wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
}

.tab__i {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.tab__t {
  /* tabBar label 必须比正文小一档：中文 12.6pt 是四字平铺的可读上限，
     再大就会显得笨重、也会挤压图标 */
  font-size: 24rpx;
  line-height: 1;
  letter-spacing: 0.04em;
  /* 未选中压到 4 号灰，选中的墨色 + 600 字重才拉得开对比 */
  color: var(--ink-4, #8E887B);
  transition: color 0.2s ease;
}

.tab--on .tab__t {
  color: var(--ink, #15202E);
  font-weight: 600;
}

/* 未读角标：贴在图标右上角 */
.tab__badge {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
  position: absolute;
  left: 30rpx;
  top: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  border-radius: 14rpx;
  background: var(--red-600, #B23A28);
  color: #fff;
  font-size: 19rpx;
  line-height: 28rpx;
  text-align: center;
}
