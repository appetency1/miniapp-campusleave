/* pages/student/records/records.wxss
 * 记录页是唯一用卡片的页面（定稿约定：其余页面靠细线分区）
 * 卡片：白底 + 1rpx 线 + 圆角 6px(12rpx)，无阴影
 */
.page {
  min-height: 100vh;
  background: var(--paper);
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

/* ---- 页头 ---- */
.head {
  padding-top: 40rpx;
  padding-bottom: 26rpx;
}
.head__t {
  font-size: 48rpx;
  line-height: 1.3;
  font-weight: 600;
  color: var(--ink);
}
.head__s {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--ink-3);
  letter-spacing: 0.04em;
}

/* ---- 筛选条 ---- */
.filters {
  display: flex;
  white-space: nowrap;
  margin-bottom: 30rpx;
  padding-bottom: 6rpx;
}
.filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  border: 1rpx solid var(--line-2);
  border-radius: var(--r);
  font-size: 30rpx;
  color: var(--ink-2);
  transition: all 0.18s ease;
}
.filter--on {
  background: var(--ink);
  border-color: var(--ink);
  color: #FCFBF8;
}

/* ---- 卡片列表 ---- */
.cards {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.card {
  padding: 26rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--r);
}
.card:active {
  background: var(--paper-2);
}

.card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 编号：衬线体，小字，弱化但可辨识 */
.card__no {
  font-size: 28rpx;
  letter-spacing: 0.08em;
  color: var(--ink-4);
}

.card__range {
  margin-top: 12rpx;
  font-size: 32rpx;
  letter-spacing: 0.02em;
  color: var(--ink);
}

.card__type {
  margin-top: 6rpx;
  font-size: 30rpx;
  color: var(--ink-2);
}

.card__sub {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink-3);
}
.card__sub--danger {
  color: var(--red-600);
}

/* 空态 / 重试 */
.retry {
  margin-top: 20rpx;
  font-size: 32rpx;
  color: var(--accent-600);
}
