/* pages/student/home/home.wxss
 * 首页样式，数值全部对齐 formal-v2（px × 2 = rpx）
 */
.page {
  min-height: 100vh;
  background: var(--paper);
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

/* ==================== 头部 ==================== */
.greet {
  padding-top: 40rpx;
}
.greet__hi {
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.greet__meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 0.04em;
  color: var(--ink-3);
}

/* ==================== 状态行 ==================== */
.state {
  margin-top: 56rpx;
  font-size: 24rpx;
  line-height: 1.4;
  letter-spacing: 0.06em;
  color: var(--blue-700);
}
.state--warn {
  color: var(--amber-600);
}
.state--danger {
  color: var(--red-600);
}
.state--muted {
  color: var(--ink-3);
}

/* ==================== 时间区 ==================== */
.timeblock {
  margin-top: 12rpx;
}

/* 区间：10.20 08:00 — 10.20 18:00 */
.range {
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: 0.02em;
  color: var(--ink-2);
}

/* 大数字区 */
.bigrow {
  display: flex;
  flex-direction: column;
  margin-top: 26rpx;
}
.bigrow__lb {
  font-size: 22rpx;
  letter-spacing: 0.14em;
  color: var(--ink-3);
}
.bigrow__v {
  font-size: 92rpx;
  line-height: 1.14;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.bigrow__v--danger {
  color: var(--red-600);
}

/* 纯文字型大标题（已完成 / 未通过） */
.bigtext {
  margin-top: 16rpx;
  font-size: 42rpx;
  line-height: 1.45;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--ink);
}

/* 读数行 */
.reads {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--ink-2);
}
.reads__b {
  font-weight: 600;
  color: var(--ink);
}

/* ==================== 四步流程 ==================== */
.flow {
  display: flex;
  margin-top: 36rpx;
}
.flow__s {
  flex: 1;
  position: relative;
  padding-top: 32rpx;
}
/* 连接线 */
.flow__s::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 8rpx;
  height: 3rpx;
  background: var(--line-2);
}
.flow__s.is-done::before {
  background: var(--ink);
}
/* 节点圆点 */
.flow__d {
  position: absolute;
  left: 0;
  top: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 3rpx solid var(--line-2);
  box-sizing: border-box;
}
.flow__s.is-done .flow__d {
  background: var(--ink);
  border-color: var(--ink);
}
.flow__s.is-now .flow__d {
  background: var(--paper);
  border-color: var(--ink);
  border-width: 4rpx;
}
.flow__t {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 600;
  color: var(--ink-3);
}
.flow__s.is-done .flow__t,
.flow__s.is-now .flow__t {
  color: var(--ink);
}
.flow__s2 {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--ink-3);
  white-space: nowrap;
}

/* ==================== 操作区 ==================== */
.action {
  margin-top: 52rpx;
}
.links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18rpx;
}
.links__div {
  width: 1rpx;
  height: 22rpx;
  margin: 0 26rpx;
  background: var(--line-2);
}

/* 事实行 */
.facts {
  margin-top: 22rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-3);
}
.facts__b {
  color: var(--ink-2);
  font-weight: 600;
}
.facts__dot {
  margin: 0 10rpx;
  color: var(--line-2);
}

/* ==================== 场景卡（态 D / E） ==================== */
.empty2 {
  margin-top: 20rpx;
}
.empty2__t {
  font-size: 32rpx;
  line-height: 1.5;
  font-weight: 500;
  color: var(--ink-2);
  margin-bottom: 26rpx;
}

.picks {
  display: flex;
  gap: 20rpx;
}
.pick {
  flex: 1;
  padding: 28rpx 24rpx;
  border: 1rpx solid var(--line-2);
  border-radius: var(--r);
  background: transparent;
  transition: border-color 0.18s ease, background 0.18s ease;
}
.pick:active {
  border-color: var(--ink);
  background: var(--paper-2);
}
.pick__t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}
.pick__s {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.4;
}

.hint {
  margin-top: 22rpx;
  font-size: 22rpx;
  color: var(--ink-4);
  line-height: 1.6;
}

/* ==================== 本学期概览 ==================== */
.overview {
  margin-top: 46rpx;
  padding: 26rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}
.overview__t {
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--ink-3);
}
.overview__r {
  display: flex;
  margin-top: 16rpx;
}
.ov {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.ov__l {
  font-size: 22rpx;
  color: var(--ink-3);
}
.ov__b {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}
.ov__u {
  font-size: 20rpx;
  color: var(--ink-3);
}

/* ==================== 请假须知 ==================== */
.rules {
  display: flex;
  flex-direction: column;
}
.rule {
  display: flex;
  gap: 18rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.rule__i {
  flex: 0 0 auto;
  font-size: 20rpx;
  line-height: 1.9;
  color: var(--ink-4);
}
.rule__t {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.rules-note {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: var(--ink-4);
  line-height: 1.6;
}

/* ==================== 最近记录 ==================== */
.recs {
  display: flex;
  flex-direction: column;
}
.rec {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.rec__d {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--ink-2);
}
.rec__t {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}
.rec__s {
  flex: 0 0 auto;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

/* 空态里的重新加载 */
.retry {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--blue-600);
}
