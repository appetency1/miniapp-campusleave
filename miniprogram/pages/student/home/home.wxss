/* pages/student/home/home.wxss
 * 首页样式。间距/线宽/色板对齐 formal-v2（px × 2 = rpx）；
 * 但**字号不能照搬**：设计稿是 Web 尺度（正文 12px），真机上已整体上调到 iOS 尺度
 * （12px→30rpx≈15.7pt），否则手机上正文比系统字号小三成。
 */
.page {
  min-height: 100vh;
  background: var(--paper);
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

/* ==================== 头部 ==================== */
.greet {
  /* 顶部留白给足：这一屏的第一口气 */
  padding-top: 36rpx;
}
.greet__hi {
  font-size: 56rpx;
  line-height: 1.26;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.greet__meta {
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.5;
  letter-spacing: 0.02em;
  color: var(--ink-3);
}

/* ==================== 当前请假状态区 ====================
 * 外层是卡片（边界交给 .card 的 1rpx 线 + 极浅阴影），**卡内仍然不套卡**：
 *   状态词 40rpx/600/状态色  >  类型 26rpx/灰  >  区间 28rpx/中灰  >  辅助时长 24rpx/浅灰
 * 左对齐是唯一的对齐轴，所有内容贴着同一条竖线往下排，自然成组。
 */
.hero {
  margin-top: 48rpx;
}
.hero.panel {
  padding: 34rpx 32rpx 30rpx;
}

/* 面板右上的校园线稿（用户提供的图：彩色线稿 → 单色蒙版 → 染 --accent-500，
 * 300×262 / 57KB，存 miniprogram/assets/campus.png）。
 *
 * 两个必须记住的点：
 * 1) 位置要让开 28rpx 圆角，top/right 都得大于半径，否则边缘会被弧线切掉。
 * 2) 它是 z-index:0，**正文层是 1**（见下面 .panel--hero > view 那条）。
 *    真实数据里「申请区间 10.23 11:30 — 10.23 12:30」这行比设计稿长 5 个字，
 *    一定会钻到插画下面；不压层的话插画会盖在字上，把正文染灰。
 * 想关掉它：删掉这一段和 wxml 里的 <image>，面板其余部分不依赖它。 */
.hero__art {
  position: absolute;
  top: 26rpx;
  right: 18rpx;
  width: 200rpx;
  z-index: 0;
  pointer-events: none;
}
.hero.panel--hero > view,
.hero.panel--hero > button,
.hero.panel--hero > ruler {
  position: relative;
  z-index: 1;
}

.hero__status {
  margin-top: 0;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 600;
  letter-spacing: -0.01em;
  /* 默认 = 进行中的橄榄绿。状态色用双类选择器覆盖，
     否则 .hero__status 单类会把 app.wxss 里的 .state--warn 顶掉 */
  color: var(--accent-600);
}
.hero__status.state--warn { color: var(--amber-600); }
.hero__status.state--danger { color: var(--red-600); }
.hero__status.state--done { color: var(--teal-600); }
.hero__status.state--muted { color: var(--ink-3); }

/* 第二优先级：离校 · 病假 */
.hero__sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--ink-3);
}

/* 第三优先级：时间区间 */
.hero__range {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ink-2);
}

/* 第四优先级：已等待 26 分钟 / 还剩 4 小时
 * 原来压到 24rpx 浅灰（怕被误读成倒计时），但这是"待审批"态下用户唯一能感知的进展，
 * 也是"请假中"态的核心数字 —— 抬到 28rpx 中灰，与时间区间同级，仍低于状态词。 */
.hero__aux {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  letter-spacing: 0.01em;
  color: var(--ink-2);
}
.hero__aux--danger {
  color: var(--red-600);
}

/* 纯文字状态（本次请假已完成 / 申请未通过），不需要大数字 */
.hero__text {
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 500;
  color: var(--ink-2);
}
.hero__text.state--danger { color: var(--red-600); }

/* 另有 N 条待处理 */
.others {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 14rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid var(--line-2);
  border-radius: var(--r);
  font-size: 26rpx;
  color: var(--ink-3);
}
.others__arrow {
  font-size: 30rpx;
  line-height: 1;
  color: var(--ink-4);
}

/* 读数行 */
.reads {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--ink-3);
}
.reads__b {
  font-weight: 500;
  color: var(--ink-2);
}

/* ==================== 四步流程 ==================== */
.flow {
  display: flex;
  margin-top: 28rpx;
}
.flow__s {
  flex: 1;
  position: relative;
  padding-top: 24rpx;
}
/* 连接线 */
.flow__s::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 5rpx;
  height: 2rpx;
  background: var(--line);
}
/* 已走过的段落用中灰色，不跟未走过的拉开太大反差 —— 它是进度提示，不是流程图 */
.flow__s.is-done::before {
  background: var(--ink-4);
}
/* 节点圆点 */
.flow__d {
  position: absolute;
  left: 0;
  top: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 2rpx solid var(--line-2);
  box-sizing: border-box;
}
.flow__s.is-done .flow__d {
  background: var(--ink-4);
  border-color: var(--ink-4);
}
/* 当前节点实心墨色，是整条时间线上唯一的重音 */
.flow__s.is-now .flow__d {
  background: var(--ink);
  border-color: var(--ink);
}
.flow__t {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 500;
  color: var(--ink-4);
}
.flow__s.is-done .flow__t {
  color: var(--ink-2);
}
.flow__s.is-now .flow__t {
  color: var(--ink);
  font-weight: 600;
}
.flow__s2 {
  display: block;
  margin-top: 2rpx;
  /* 四步等分 + nowrap，"10.22 09:30" 是 11 字符：再大半档就会顶到相邻格 */
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-4);
  white-space: nowrap;
}

/* ==================== 操作区 ==================== */
.action {
  /* 时间线与按钮之间要多留 —— 这是"状态陈述"到"可执行动作"的转折点 */
  margin-top: 46rpx;
}
.links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 6rpx;
}
/* 撤回/取消：主动降级到脚注级，只保留危险语义的红，不与主按钮竞争 */
.action .link-btn {
  font-size: 24rpx;
  color: var(--ink-4);
  padding: 16rpx 10rpx;
}
.action .link-btn--danger {
  color: var(--red-600);
}
.links__div {
  width: 1rpx;
  height: 22rpx;
  margin: 0 26rpx;
  background: var(--line-2);
}

/* 事实行 */
.facts {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-4);
}
.facts__b {
  color: var(--ink-3);
  font-weight: 500;
}
.facts__dot {
  margin: 0 10rpx;
  color: var(--line-2);
}

/* ==================== 场景卡（态 D / E） ==================== */
.empty2 {
  margin-top: 20rpx;
}
.empty2__t {
  font-size: 36rpx;
  line-height: 1.5;
  font-weight: 500;
  color: var(--ink-2);
  margin-bottom: 26rpx;
}

.picks {
  display: flex;
  gap: 20rpx;
}
.pick {
  flex: 1;
  padding: 28rpx 24rpx;
  border: 1rpx solid var(--line-2);
  border-radius: var(--r);
  background: transparent;
  transition: border-color 0.18s ease, background 0.18s ease, transform 0.16s ease;
}
.pick:active {
  border-color: var(--ink);
  background: var(--paper-2);
}
.pick__ico {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 14rpx;
  display: block;
}
/* 按下反馈：轻微缩放，避免"点了没反应"的生硬感 */
.pick--press {
  transform: scale(0.975);
  border-color: var(--ink);
  background: var(--paper-2);
}
.pick__t {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}
.pick__s {
  margin-top: 6rpx;
  font-size: 28rpx;
  color: var(--ink-3);
  line-height: 1.4;
}

.hint {
  margin-top: 22rpx;
  font-size: 28rpx;
  color: var(--ink-4);
  line-height: 1.6;
}

/* ==================== 本学期概览 ==================== */
.overview {
  margin-top: 32rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}
.overview__t {
  font-size: 28rpx;
  letter-spacing: 0.08em;
  color: var(--ink-3);
}
.overview__r {
  display: flex;
  margin-top: 16rpx;
}
.ov {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.ov__l {
  font-size: 28rpx;
  color: var(--ink-3);
}
.ov__b {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--ink);
}
.ov__u {
  font-size: 26rpx;
  color: var(--ink-3);
}

/* ==================== 请假须知 ==================== */
.rules {
  display: flex;
  flex-direction: column;
}
.rule {
  display: flex;
  gap: 18rpx;
  padding: 11rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.rule__i {
  flex: 0 0 auto;
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--ink-4);
}
.rule__t {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink-2);
}
.rules-note {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: var(--ink-4);
  line-height: 1.6;
}

/* ==================== 最近记录 ==================== */
.recs {
  display: flex;
  flex-direction: column;
}
/* 记录也走卡片：它是"已经发生的事"的清单，和当前请假同属"事实"；
   卡内的行分隔仍用 hairline，所以视觉上是一张卡里排 3 行，不是 3 张卡。 */
.panel--list {
  padding: 4rpx 30rpx;
}
.rec {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.rec:last-child {
  border-bottom: none;
}
/* 日期列两行（10.21 / 周三），固定宽度让右侧摘要起点上下对齐
   —— 单行日期在纵向排 3 行时会左右参差，两行反而稳 */
.rec__d {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  width: 84rpx;
}
.rec__d1 {
  font-size: 26rpx;
  line-height: 1.35;
  color: var(--ink-3);
}
.rec__d2 {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--ink-4);
}
.rec__t {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}
.rec__s {
  flex: 0 0 auto;
  font-size: 26rpx;
  /* 状态只用文字颜色区分，不做色块标签 —— 列表右侧堆彩色胶囊会让整页变吵，
     且淡底与白卡的对比只有 1.1:1，色块本身立不住 */
  padding: 0;
  background: transparent;
  color: var(--ink-4);
}
.rec__s.chip--amber { color: var(--amber-600); background: transparent; }
.rec__s.chip--red { color: var(--red-600); background: transparent; }
.rec__s.chip--teal { color: var(--ink-3); background: transparent; }
.rec__s.chip--blue { color: var(--accent-600); background: transparent; }
.rec__s.chip--grey { color: var(--ink-4); background: transparent; }

/* 空态里的重新加载 */
.retry {
  margin-top: 20rpx;
  font-size: 32rpx;
  color: var(--accent-600);
}

/* 出错时显示当前生效的后端地址（开发期诊断用，正式版可删） */
.empty__dbg {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-4);
  word-break: break-all;
}
