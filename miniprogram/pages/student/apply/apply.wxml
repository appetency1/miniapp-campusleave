<!--
  pages/student/apply/apply.wxml —— 申请请假

  三条针对实测反馈的改动：
    1. 从首页卡片进来 → 场景已定，顶部只显示一行只读摘要（带"更改"），不再让你重选
    2. 时间：整行点开一个「日期 + 时间」多列选择器，点哪都能改整个时间
    3. 去向：省/市/区选择器 + 详细地址，不允许整段自由文本
-->
<view class="page">

  <!-- 自定义导航 -->
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav__back" bindtap="onBack" hover-class="nav__back--press">
      <view class="nav__arrow"></view>
    </view>
    <view class="nav__t">申请请假</view>
  </view>

  <scroll-view class="body" scroll-y>
    <view class="pad">

      <!-- ============ 场景 ============ -->
      <!-- 已确定：只读摘要 -->
      <view wx:if="{{sceneLocked}}" class="locked">
        <view class="locked__l">
          <text class="locked__t">{{sceneLabel}}</text>
          <text class="locked__s">{{sceneSub}}</text>
        </view>
        <text class="locked__change" bindtap="onUnlockScene">更改</text>
      </view>

      <!-- 未确定：两块选择 -->
      <view wx:else class="field">
        <view class="field__lb">请假场景</view>
        <view class="picks">
          <view class="pick {{form.scene === 'OFF_CAMPUS' ? 'pick--on' : ''}}"
                hover-class="press" data-v="OFF_CAMPUS" bindtap="onScene">
            <view class="pick__t">离校</view>
            <view class="pick__s">返校定位销假</view>
          </view>
          <view class="pick {{form.scene === 'ON_CAMPUS' ? 'pick--on' : ''}}"
                hover-class="press" data-v="ON_CAMPUS" bindtap="onScene">
            <view class="pick__t">校内</view>
            <view class="pick__s">结束后自主确认</view>
          </view>
        </view>
        <view wx:if="{{err.scene}}" class="err">请选择请假场景</view>
      </view>

      <!-- ============ 类型 ============ -->
      <view class="field">
        <view class="field__lb">请假类型</view>
        <view class="seg">
          <view wx:for="{{types}}" wx:key="value"
                class="seg__i {{form.leaveType === item.value ? 'seg__i--on' : ''}}"
                hover-class="seg__i--press"
                data-v="{{item.value}}" bindtap="onType">{{item.label}}</view>
        </view>
      </view>

      <!-- ============ 时间 ============ -->
      <view class="field">
        <view class="field__lb">
          请假时间
          <text class="field__hint">点整行修改日期与时间</text>
        </view>

        <!-- 快捷项：只挪日期 -->
        <view class="quick">
          <text wx:for="{{quickDays}}" wx:key="label"
                class="quick__i {{dayOffset === index ? 'quick__i--on' : ''}}"
                hover-class="press"
                data-i="{{index}}" bindtap="onQuickDay">{{item}}</text>
        </view>

        <!-- 开始：整行可点，弹出「日期+时间」双列 -->
        <picker mode="multiSelector" range="{{range}}" value="{{startIdx}}" bindchange="onStartChange">
          <view class="timerow" hover-class="timerow--press">
            <text class="timerow__k">开始</text>
            <text class="timerow__v num">{{startText}}</text>
            <text class="timerow__arrow">›</text>
          </view>
        </picker>

        <picker mode="multiSelector" range="{{range}}" value="{{endIdx}}" bindchange="onEndChange">
          <view class="timerow" hover-class="timerow--press">
            <text class="timerow__k">结束</text>
            <text class="timerow__v num">{{endText}}</text>
            <text class="timerow__arrow">›</text>
          </view>
        </picker>

        <view wx:if="{{err.time}}" class="err">{{err.time}}</view>
      </view>

      <!-- ============ 理由 ============ -->
      <view class="field">
        <view class="field__lb">
          请假理由
          <text class="field__hint">不少于 5 个字</text>
        </view>
        <view class="ta">
          <textarea class="ta__in" value="{{form.reason}}" maxlength="120"
                    placeholder="说明原因，便于辅导员判断"
                    placeholder-class="ph"
                    bindinput="onReason" auto-height />
          <view class="ta__count num">{{form.reason.length}}/120</view>
        </view>
        <view wx:if="{{err.reason}}" class="err">请填写请假理由（不少于 5 个字）</view>
      </view>

      <!-- ============ 离校去向（仅离校） ============ -->
      <view wx:if="{{form.scene === 'OFF_CAMPUS'}}" class="field">
        <view class="field__lb">
          离校去向
          <text class="field__hint">省 / 市 / 区</text>
        </view>

        <picker mode="region" value="{{region}}" bindchange="onRegion">
          <view class="timerow" hover-class="timerow--press">
            <text class="timerow__k">所在</text>
            <text class="timerow__v {{regionText ? '' : 'timerow__v--ph'}}">{{regionText || '请选择省 / 市 / 区'}}</text>
            <text class="timerow__arrow">›</text>
          </view>
        </picker>

        <input class="line-in" value="{{addressDetail}}" maxlength="60"
               placeholder="详细地址（如：文一西路 123 号）" placeholder-class="ph"
               bindinput="onAddress" />
        <view wx:if="{{err.region}}" class="err">{{err.region}}</view>
      </view>

      <!-- ============ 联系电话 ============ -->
      <view class="field">
        <view class="field__lb">
          联系电话
          <text class="field__hint">11 位手机号</text>
        </view>
        <input class="line-in num" type="number" value="{{form.contactPhone}}" maxlength="11"
               placeholder="请假期间可联系到你的号码" placeholder-class="ph"
               bindinput="onPhone" />
        <view wx:if="{{err.phone}}" class="err">{{err.phone}}</view>
      </view>

      <!-- ============ 材料 ============ -->
      <view class="field">
        <view class="field__lb">
          证明材料
          <text class="field__hint">病假建议上传，非必传</text>
        </view>

        <view wx:for="{{materials}}" wx:key="fileUrl" class="mat">
          <text class="mat__n">{{item.fileName}}</text>
          <text class="mat__x" data-i="{{index}}" bindtap="onRemoveMaterial">移除</text>
        </view>

        <view class="mat-add" hover-class="press" bindtap="onPickMaterial">
          <text class="mat-add__i">＋</text>
          <text class="mat-add__t">{{uploading ? '上传中…' : '添加图片或 PDF'}}</text>
        </view>
        <view wx:if="{{err.material}}" class="err">{{err.material}}</view>
      </view>

      <view style="height: 40rpx;"></view>
    </view>
  </scroll-view>

  <!-- 底部提交 -->
  <view class="bottom">
    <button class="btn {{submitting ? 'btn--disabled' : ''}}" hover-class="is-active"
            disabled="{{submitting}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : '提交申请'}}
    </button>
  </view>
</view>
