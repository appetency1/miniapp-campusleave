/* pages/student/apply/apply.wxss
 * 申请页
 *
 * 交互反馈统一在这里定义：
 *   .press           通用按压（缩放 + 变深），给卡片/快捷项/加号用
 *   .timerow--press  整行时间行的按压底色
 *   .seg__i--press   分段按压
 *   .err             错误提示淡入（避免突然跳出一行把布局顶飞）
 *   页面进场 fadeUp
 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
  overflow: hidden;
}

/* ---- 导航 ---- */
.nav {
  flex: 0 0 auto;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-bottom: 1rpx solid var(--line);
}
.nav__back {
  position: absolute;
  left: 20rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.18s ease, transform 0.16s ease;
}
.nav__back--press {
  background: var(--paper-2);
  transform: scale(0.94);
}
.nav__arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--ink);
  border-bottom: 3rpx solid var(--ink);
  transform: rotate(45deg);
}
.nav__t {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

/* ---- 页面进场 ---- */
.body { flex: 1; min-height: 0; }
.pad {
  padding: 0 40rpx;
  animation: fadeUp 0.32s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(18rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.field {
  padding-top: 34rpx;
  padding-bottom: 6rpx;
}
.field__lb {
  font-size: 30rpx;
  color: var(--ink-2);
  margin-bottom: 16rpx;
}
.field__hint {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--ink-4);
}

/* ---- 错误提示：淡入 ---- */
.err {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: var(--red-600);
  line-height: 1.5;
  animation: errIn 0.2s ease both;
}
@keyframes errIn {
  from { opacity: 0; transform: translateY(-6rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---- 通用按压 ---- */
.press {
  transform: scale(0.977);
  opacity: 0.92;
}

/* ---- 场景已确定：只读摘要 ---- */
.locked {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid var(--line-2);
  border-radius: var(--r);
  background: var(--paper-2);
}
.locked__l {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.locked__t {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}
.locked__s {
  font-size: 28rpx;
  color: var(--ink-3);
}
.locked__change {
  font-size: 30rpx;
  color: var(--accent-600);
  padding: 6rpx 4rpx;
}

/* ---- 场景：两块选择 ---- */
.picks {
  display: flex;
  gap: 18rpx;
}
.pick {
  flex: 1;
  padding: 24rpx 22rpx;
  border: 1rpx solid var(--line-2);
  border-radius: var(--r);
  transition: border-color 0.18s ease, background 0.18s ease, transform 0.16s ease;
}
.pick--on {
  border-color: var(--ink);
  background: var(--paper-2);
}
.pick__t {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}
.pick__s {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--ink-3);
  line-height: 1.4;
}

/* ---- 类型：三段 ---- */
.seg {
  display: flex;
  border: 1rpx solid var(--line-2);
  border-radius: var(--r);
  overflow: hidden;
}
.seg__i {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 32rpx;
  color: var(--ink-2);
  border-right: 1rpx solid var(--line-2);
  transition: background 0.16s ease, color 0.16s ease;
}
.seg__i:last-child { border-right: none; }
.seg__i--on {
  background: var(--ink);
  color: #FCFBF8;
  font-weight: 500;
}
.seg__i--press {
  background: var(--paper-2);
}

/* ---- 快捷日期 ---- */
.quick {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.quick__i {
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--line-2);
  border-radius: var(--r);
  font-size: 28rpx;
  color: var(--ink-2);
  transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease, transform 0.16s ease;
}
.quick__i--on {
  border-color: var(--ink);
  color: var(--ink);
  font-weight: 500;
  background: var(--paper-2);
}

/* ---- 时间 / 地区：整行可点 ---- */
.timerow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
  transition: background 0.16s ease;
}
.timerow--press {
  background: var(--paper-2);
}
.timerow__k {
  flex: 0 0 auto;
  width: 72rpx;
  font-size: 30rpx;
  color: var(--ink-3);
}
.timerow__v {
  flex: 1;
  font-size: 34rpx;
  color: var(--ink);
}
.timerow__v--ph {
  color: var(--ink-4);
  font-size: 32rpx;
}
.timerow__arrow {
  flex: 0 0 auto;
  font-size: 34rpx;
  line-height: 1;
  color: var(--ink-4);
}

/* ---- 理由 ---- */
.ta {
  position: relative;
  border-bottom: 1rpx solid var(--line-2);
  padding-bottom: 8rpx;
  transition: border-color 0.2s ease;
}
.ta__in {
  width: 100%;
  min-height: 130rpx;
  font-size: 34rpx;
  line-height: 1.7;
  color: var(--ink);
  box-sizing: border-box;
}
.ta__count {
  position: absolute;
  right: 0;
  bottom: 6rpx;
  font-size: 26rpx;
  color: var(--ink-4);
}

/* ---- 单行输入 ---- */
.line-in {
  height: 72rpx;
  margin-top: 8rpx;
  font-size: 34rpx;
  color: var(--ink);
  border-bottom: 1rpx solid var(--line-2);
  transition: border-color 0.2s ease;
}
.ph {
  color: var(--ink-4);
  font-size: 32rpx;
}

/* ---- 材料 ---- */
.mat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.mat__n {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mat__x {
  flex: 0 0 auto;
  font-size: 28rpx;
  color: var(--red-600);
}

.mat-add {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 24rpx 0;
  border: 1rpx dashed var(--line-2);
  border-radius: var(--r);
  transition: background 0.16s ease, transform 0.16s ease, border-color 0.16s ease;
}
.mat-add__i {
  font-size: 34rpx;
  color: var(--ink-3);
}
.mat-add__t {
  font-size: 30rpx;
  color: var(--ink-3);
}

/* ---- 底部提交 ---- */
.bottom {
  flex: 0 0 auto;
  padding: 20rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid var(--line);
}
