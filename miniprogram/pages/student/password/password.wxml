<!-- 修改密码：三个输入 + 一个按钮，不引组件 -->
<view class="page">

  <!-- 自定义导航（与其他页一致的返回箭头） -->
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav__back" bindtap="onBack">
      <view class="nav__arrow"></view>
    </view>
    <view class="nav__t">修改密码</view>
  </view>

  <view class="body">
    <view class="hint">密码至少 6 位。修改后请用新密码登录。</view>

    <view class="field">
      <text class="field__l">原密码</text>
      <input class="field__i" password placeholder="当前密码"
             value="{{oldPassword}}" bindinput="onOld" />
    </view>

    <view class="field">
      <text class="field__l">新密码</text>
      <input class="field__i" password placeholder="至少 6 位"
             value="{{newPassword}}" bindinput="onNew" />
    </view>

    <view class="field">
      <text class="field__l">确认新密码</text>
      <input class="field__i" password placeholder="再输入一次"
             value="{{confirm}}" bindinput="onConfirm" />
    </view>

    <view wx:if="{{error}}" class="err">{{error}}</view>

    <button class="submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      保存
    </button>
  </view>

</view>
