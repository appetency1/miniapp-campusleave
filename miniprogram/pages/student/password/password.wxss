/* 修改密码页：只有导航 + 三个字段 + 按钮，样式复用 app.wxss 的变量 */
.page {
  min-height: 100vh;
  background: var(--paper);
}

/* ---- 自定义导航 ---- */
.nav {
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
  box-sizing: content-box;
}
.nav__back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
}
.nav__arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--ink);
  border-bottom: 3rpx solid var(--ink);
  transform: rotate(45deg);
}
.nav__t {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

/* ---- 表单 ---- */
.body {
  padding: 24rpx 40rpx 60rpx;
}
.hint {
  margin-bottom: 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-3);
}

.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.field__l {
  flex: 0 0 160rpx;
  font-size: 30rpx;
  color: var(--ink-2);
}
.field__i {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}

.err {
  margin-top: 22rpx;
  font-size: 26rpx;
  color: var(--red-600);
}

.submit {
  margin-top: 48rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--r-btn);
  background: var(--ink);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.submit::after { border: 0; }
.submit[disabled] { opacity: .6; }
