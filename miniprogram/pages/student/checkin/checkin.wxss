/* pages/student/checkin/checkin.wxss
 * 返校销假：雷达环是这一屏的主角，文案与动作都围绕它垂直居中
 */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--paper);
}

.nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
}
.nav__back {
  position: absolute;
  left: 20rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav__arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--ink);
  border-bottom: 3rpx solid var(--ink);
  transform: rotate(45deg);
}
.nav__t {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 40rpx 0;
  box-sizing: border-box;
}

/* ==================== 雷达环 ==================== */
.radar {
  position: relative;
  width: 336rpx;
  height: 336rpx;
  margin: 16rpx 0 56rpx;
}
.radar__ring {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border: 1rpx solid var(--line);
  border-radius: 50%;
}
.radar__ring--in {
  top: 68rpx; left: 68rpx; right: 68rpx; bottom: 68rpx;
  border-color: var(--line-2);
}
.radar__pulse {
  position: absolute;
  top: 104rpx; left: 104rpx; right: 104rpx; bottom: 104rpx;
  border-radius: 50%;
  background: var(--accent-500);
  opacity: 0.1;
  animation: pulse 1.8s ease-out infinite;
}
@keyframes pulse {
  0%   { transform: scale(0.7); opacity: 0.16; }
  100% { transform: scale(2.1); opacity: 0; }
}
.radar__core {
  position: absolute;
  top: 104rpx; left: 104rpx; right: 104rpx; bottom: 104rpx;
  border-radius: 50%;
  background: var(--accent-50);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 定位图标：外圈 + 中心点，纯 CSS */
.ico {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--accent-600);
  border-radius: 50%;
  box-sizing: border-box;
}
.ico::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin: -4rpx 0 0 -4rpx;
  background: var(--accent-600);
  border-radius: 50%;
}
.ico--ok { border-color: var(--ink); }
.ico--ok::after { background: var(--ink); }
.ico--fail { border-color: var(--red-600); }
.ico--fail::after { background: var(--red-600); }

/* 通过态：停脉冲，核心改为纸色 */
.radar--ok .radar__pulse { display: none; }
.radar--ok .radar__core { background: var(--paper-2); }

/* 失败态 */
.radar--fail .radar__pulse { animation: none; opacity: 0; }
.radar--fail .radar__core { background: var(--red-50); }

/* ==================== 文案 ==================== */
.title {
  font-size: 44rpx;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--ink);
  text-align: center;
}
.desc {
  margin-top: 18rpx;
  max-width: 560rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--ink-2);
  text-align: center;
}
.meta {
  margin-top: 30rpx;
  font-size: 28rpx;
  letter-spacing: 0.04em;
  color: var(--ink-4);
}
.hint {
  margin-top: 18rpx;
  font-size: 28rpx;
  color: var(--ink-3);
}

/* ==================== 动作 ==================== */
.acts {
  width: 100%;
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.note {
  margin-top: 50rpx;
  font-size: 28rpx;
  color: var(--ink-4);
  text-align: center;
}

/* ==================== 人工核验表单 ==================== */
.review {
  width: 100%;
  margin-top: 46rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--line);
}
.review__lb {
  font-size: 28rpx;
  color: var(--ink-3);
  margin-bottom: 12rpx;
}
.review__in {
  width: 100%;
  min-height: 120rpx;
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--ink);
  border-bottom: 1rpx solid var(--line-2);
  box-sizing: border-box;
}
.ph {
  color: var(--ink-4);
  font-size: 30rpx;
}
.review__acts {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}
.link-btn--primary {
  color: var(--accent-600);
  font-weight: 500;
}

/* ==================== 模拟位置（演示） ==================== */
.mock {
  margin: 20rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mock__k {
  font-size: 26rpx;
  color: var(--ink-4);
  letter-spacing: 0.08em;
}
.mock__v {
  font-size: 28rpx;
  color: var(--ink-3);
  padding: 6rpx 14rpx;
  border: 1rpx solid var(--line-2);
  border-radius: var(--r);
}
