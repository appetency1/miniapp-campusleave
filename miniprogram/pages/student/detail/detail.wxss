/* pages/student/detail/detail.wxss
 * 详情页：自定义导航 + 可滚动内容 + 底部固定操作栏
 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
  overflow: hidden;
}

/* ---- 自定义导航 ---- */
.nav {
  flex: 0 0 auto;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--paper);
  border-bottom: 1rpx solid var(--line);
}
.nav__back {
  position: absolute;
  left: 20rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 返回箭头用两个边框拼一个 "<"，不用图片 */
.nav__arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 3rpx solid var(--ink);
  border-bottom: 3rpx solid var(--ink);
  transform: rotate(45deg);
}
.nav__t {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.02em;
}

/* ---- 内容区 ---- */
.body {
  flex: 1;
  min-height: 0;
}
.pad {
  padding: 0 40rpx 40rpx;
}

/* 状态区 */
.state {
  margin-top: 36rpx;
  font-size: 26rpx;
  letter-spacing: 0.06em;
  color: var(--blue-700);
}
.state--warn { color: var(--amber-600); }
.state--danger { color: var(--red-600); }
.state--done { color: var(--teal-600); }
.state--muted { color: var(--ink-4); }

.range {
  margin-top: 14rpx;
  font-size: 36rpx;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--ink);
}
.no {
  margin-top: 10rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: var(--ink-4);
}

/* ---- 时间轴 ---- */
.timeline {
  display: flex;
  flex-direction: column;
}
.tl {
  position: relative;
  display: flex;
  gap: 22rpx;
  padding-bottom: 30rpx;
}
/* 竖线：最后一项不画 */
.tl::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 20rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--line-2);
}
.tl:last-child::before {
  display: none;
}
.tl__d {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: var(--paper);
  border: 2rpx solid var(--line-2);
  box-sizing: border-box;
  z-index: 1;
}
.tl.is-done .tl__d {
  background: var(--ink);
  border-color: var(--ink);
}
.tl.is-now .tl__d {
  background: var(--paper);
  border-color: var(--blue-500);
  border-width: 3rpx;
}
.tl__body {
  flex: 1;
}
.tl__t {
  font-size: 26rpx;
  color: var(--ink-3);
  line-height: 1.4;
}
.tl.is-done .tl__t,
.tl.is-now .tl__t {
  color: var(--ink);
  font-weight: 500;
}
.tl__s {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-4);
}

/* ---- 行列表 ---- */
.rows {
  display: flex;
  flex-direction: column;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.row--col {
  flex-direction: column;
  align-items: stretch;
  gap: 6rpx;
}
.row__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row__l {
  font-size: 26rpx;
  color: var(--ink-2);
  flex: 0 0 auto;
}
.row__v {
  font-size: 26rpx;
  color: var(--ink);
  text-align: right;
  word-break: break-all;
}
.row__v--danger {
  color: var(--red-600);
}
.row__sub {
  font-size: 22rpx;
  color: var(--ink-4);
}

/* 原因段落 */
.paragraph {
  font-size: 26rpx;
  line-height: 1.75;
  color: var(--ink-2);
  padding: 4rpx 0 8rpx;
}

/* 材料 */
.mats {
  display: flex;
  flex-direction: column;
}
.mat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.mat__n {
  font-size: 26rpx;
  color: var(--ink);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mat__s {
  flex: 0 0 auto;
  margin-left: 20rpx;
  font-size: 22rpx;
  color: var(--ink-4);
}

/* ---- 底部操作栏 ---- */
.bottom {
  flex: 0 0 auto;
  padding: 20rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--paper);
  border-top: 1rpx solid var(--line);
}
.bottom__links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-top: 12rpx;
}

/* 空态 / 重试 */
.retry {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--blue-600);
}
