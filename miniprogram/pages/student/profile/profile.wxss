/* pages/student/profile/profile.wxss
 * 我的：身份区 + 三项统计 + 细线行列表，全页无卡片
 */
.page {
  min-height: 100vh;
  background: var(--paper);
  padding-left: 40rpx;
  padding-right: 40rpx;
  box-sizing: border-box;
}

/* ---- 身份区 ---- */
.me {
  padding-top: 50rpx;
  padding-bottom: 36rpx;
}
.me__name {
  font-size: 48rpx;
  line-height: 1.3;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.me__meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: var(--ink-3);
}

/* ---- 三项统计 ---- */
.stats {
  display: flex;
  align-items: stretch;
  padding: 30rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}
.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.st__v {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--ink);
}
.st__v--danger {
  color: var(--red-600);
}
.st__l {
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.06em;
}
.st__div {
  width: 1rpx;
  background: var(--line);
  margin: 6rpx 0;
}

/* ---- 细线行列表 ---- */
.rows {
  display: flex;
  flex-direction: column;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.row__l {
  font-size: 26rpx;
  color: var(--ink-2);
}
.row__v {
  font-size: 26rpx;
  color: var(--ink);
  max-width: 60%;
  text-align: right;
}
.row__v--sm {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ---- 退出登录 ---- */
.logout {
  margin-top: 60rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 28rpx;
  color: var(--ink-2);
}
