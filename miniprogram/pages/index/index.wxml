<!-- pages/index/index.wxml —— 占位首页（待按定稿 formal-v2 实现） -->
<view class="home page-pad">

  <view class="home__meta">{{student}}</view>

  <view class="home__hero">
    <view class="home__label">首页待落地</view>
    <view class="home__hint">按定稿 <text class="num">formal-v2</text> 逐屏实现</view>
  </view>

  <view class="rule"></view>

  <view class="home__list">
    <view class="home__item" wx:for="{{screens}}" wx:key="*this">
      <text class="home__idx num">{{index + 1}}</text>
      <text class="home__name">{{item}}</text>
    </view>
  </view>

</view>
