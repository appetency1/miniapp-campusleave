<!--
  pages/login/login.wxml —— 登录页

  版式（重设计稿 A「刻度尺引子」）：
    顶部一道刻度尺（把首页的记忆点前置到入口）+ 蓝点表示「此刻」
    → 校名（衬线大字）→ LA · 学生端（等宽小字）
    → 学号 / 密码（仅底线，聚焦时底线转墨色）
    → 墨色实心主按钮 → 底部说明
    → 演示账号（虚线分隔，贴在最底）

  刻度尺用 CSS 渐变画刻度，零图片资源，与 components/ruler 同一套画法。
-->
<view class="wrap">

  <!-- 品牌标记：刻度尺 -->
  <view class="mark">
    <view class="mark__ln"></view>
    <!-- 短刻度：12 等分 -->
    <view class="mark__ticks"></view>
    <!-- 长刻度：6 等分 -->
    <view class="mark__ticks2"></view>
    <!-- 蓝点：此刻 -->
    <view class="mark__dot"></view>
  </view>

  <view class="ttl">校园请假</view>
  <view class="sub num">LA · 学生端</view>

  <!-- 表单 -->
  <view class="form">
    <view class="field {{focus === 'username' ? 'field--on' : ''}}">
      <view class="field__lb">学号</view>
      <input
        class="field__in num"
        type="text"
        value="{{username}}"
        placeholder="请输入学号"
        placeholder-class="ph"
        maxlength="20"
        bindinput="onUsernameInput"
        bindfocus="onFocus"
        bindblur="onBlur"
        data-name="username"
      />
    </view>

    <view class="field {{focus === 'password' ? 'field--on' : ''}}">
      <view class="field__lb">密码</view>
      <input
        class="field__in"
        password="{{true}}"
        value="{{password}}"
        placeholder="请输入密码"
        placeholder-class="ph"
        maxlength="32"
        bindinput="onPasswordInput"
        bindfocus="onFocus"
        bindblur="onBlur"
        data-name="password"
        confirm-type="done"
        bindconfirm="onLogin"
      />
    </view>

    <!-- 错误提示：用红色细条，不弹 toast（toast 会被键盘挡住） -->
    <view wx:if="{{error}}" class="err">{{error}}</view>

    <button
      class="btn login-btn {{submitting ? 'btn--disabled' : ''}}"
      hover-class="is-active"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onLogin"
    >{{submitting ? '登录中' : '登 录'}}</button>

    <view class="tip">账号由学校统一发放，忘记密码请联系辅导员</view>
  </view>

  <!-- 演示辅助：一键填充演示账号（毕设演示用，正式版可删）
       长按这一行 → 切换后端地址（换网络后不用改代码重新编译） -->
  <view class="demo" bindtap="fillDemo" bindlongpress="onServerTap">
    <text class="demo__t num">演示账号</text>
    <text class="demo__v num">{{demoText}}</text>
  </view>

  <!-- 当前接口地址：联调时一眼看到请求打到哪台机器（正式版可删） -->
  <view class="api" bindtap="onServerTap">
    <text class="api__k">接口</text>
    <text class="api__v num">{{apiHost}}</text>
  </view>

</view>
