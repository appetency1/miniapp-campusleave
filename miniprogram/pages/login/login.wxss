/* pages/login/login.wxss
 * 登录页 · 重设计稿 A「刻度尺引子」
 * 色板/字体/圆角沿用 formal-v2 定稿，只改构图与节奏。
 * 不用卡片、不用阴影、不用大圆角（这些在定稿里都被否决过）。
 */
.wrap {
  min-height: 100vh;
  background: var(--paper);
  /* 顶部留白：避开系统胶囊，再留出呼吸位 */
  padding: 150rpx 40rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ==================== 刻度尺标记 ==================== */
.mark {
  position: relative;
  height: 34rpx;
  margin-bottom: 44rpx;
}

/* 基线 */
.mark__ln {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: var(--line-2);
}

/* 短刻度：12 等分 */
.mark__ticks {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 16rpx;
  background-image: linear-gradient(to right, rgba(21, 32, 46, 0.20) 1rpx, transparent 1rpx);
  background-size: calc(100% / 12) 16rpx;
  background-repeat: repeat-x;
}

/* 长刻度：6 等分，颜色更深 */
.mark__ticks2 {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 30rpx;
  background-image: linear-gradient(to right, rgba(21, 32, 46, 0.34) 1rpx, transparent 1rpx);
  background-size: calc(100% / 6) 30rpx;
  background-repeat: repeat-x;
}

/* 蓝点：此刻（放在 1/3 处） */
.mark__dot {
  position: absolute;
  left: 33.3%;
  bottom: -6rpx;
  width: 12rpx;
  height: 12rpx;
  background: var(--accent-600);
}
/* 蓝点外圈的浅色方块（呼应首页刻度尺的指针造型） */
.mark__dot::after {
  content: "";
  position: absolute;
  left: -6rpx;
  top: -6rpx;
  width: 24rpx;
  height: 24rpx;
  background: var(--accent-600);
  opacity: 0.16;
}

/* ==================== 标题 ==================== */
.ttl {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", system-ui, sans-serif;
  font-size: 60rpx;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--ink);
}

.sub {
  margin-top: 14rpx;
  font-size: 28rpx;
  letter-spacing: 0.14em;
  color: var(--ink-3);
}

/* ==================== 表单 ==================== */
.form {
  margin-top: 64rpx;
}

.field {
  margin-bottom: 44rpx;
  /* 只有底部 1rpx 线，聚焦时颜色变深 */
  border-bottom: 1rpx solid var(--line-2);
  transition: border-color 0.2s ease;
}
.field--on {
  border-bottom-color: var(--ink);
}

.field__lb {
  font-size: 28rpx;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin-bottom: 8rpx;
}

.field__in {
  height: 74rpx;
  font-size: 36rpx;
  color: var(--ink);
  /* 输入框本身不要背景和边框，让底线成为唯一分隔 */
  background: transparent;
}

/* placeholder 颜色（必须用 class，WXSS 不支持 input 的 ::placeholder） */
.ph {
  color: var(--ink-4);
  font-size: 34rpx;
}

/* 错误提示 */
.err {
  margin: -12rpx 0 24rpx;
  font-size: 30rpx;
  color: var(--red-600);
  line-height: 1.5;
}

/* 登录按钮：墨色实心，高 96rpx，圆角 12rpx(=6px) */
.login-btn {
  margin-top: 24rpx;
  letter-spacing: 0.28em;
  /* 覆盖小程序 button 默认样式 */
  padding: 0;
  line-height: 96rpx;
}

/* 底部说明 */
.tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--ink-3);
  line-height: 1.7;
}

/* ==================== 演示账号 ==================== */
/* 贴在最底部：margin-top auto 把剩余空间推给它 */
.demo {
  margin-top: auto;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.demo__t {
  font-size: 28rpx;
  color: var(--ink-4);
  letter-spacing: 0.08em;
}
.demo__v {
  font-size: 28rpx;
  color: var(--ink-3);
}

/* 当前接口地址：极轻的一行，联调时看请求打到哪 */
.api {
  margin-top: 12rpx;
  padding-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.api__k {
  font-size: 26rpx;
  color: var(--ink-4);
  letter-spacing: 0.08em;
}
.api__v {
  font-size: 26rpx;
  color: var(--ink-4);
}
