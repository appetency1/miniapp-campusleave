/* pages/login/login.wxss
 * 纸感登录页：大量留白 + 细底线输入 + 墨色实心按钮
 * 不用卡片、不用阴影、不用大圆角（这些在定稿里都被否决过）
 */
.wrap {
  min-height: 100vh;
  background: var(--paper);
  /* 顶部留白 96rpx（约 48px），避开系统胶囊的视觉压力 */
  padding: 180rpx 40rpx 60rpx;
  box-sizing: border-box;
}

/* ---- 品牌区 ---- */
.brand {
  margin-bottom: 90rpx;
}
.brand__t {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--ink);
  line-height: 1.2;
}
.brand__s {
  margin-top: 12rpx;
  font-size: 22rpx;
  letter-spacing: 0.14em;
  color: var(--ink-3);
}

/* ---- 表单 ---- */
.form {
  display: flex;
  flex-direction: column;
}

.field {
  margin-bottom: 46rpx;
  /* 只有底部 1rpx 线，聚焦时颜色变深 */
  border-bottom: 1rpx solid var(--line-2);
  transition: border-color 0.2s ease;
}
.field--on {
  border-bottom-color: var(--ink);
}

.field__lb {
  font-size: 22rpx;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin-bottom: 10rpx;
}

.field__in {
  height: 72rpx;
  font-size: 32rpx;
  color: var(--ink);
  /* 输入框本身不要背景和边框，让底线成为唯一分隔 */
  background: transparent;
}

/* placeholder 颜色（必须用 class，WXSS 不支持 input 的 ::placeholder） */
.ph {
  color: var(--ink-4);
  font-size: 30rpx;
}

/* 错误提示 */
.err {
  margin: -14rpx 0 26rpx;
  font-size: 24rpx;
  color: var(--red-600);
  line-height: 1.5;
}

/* 登录按钮：墨色实心，高 96rpx，圆角 12rpx(=6px) */
.login-btn {
  margin-top: 26rpx;
  letter-spacing: 0.28em;
  /* 覆盖小程序 button 默认样式 */
  padding: 0;
  line-height: 96rpx;
}

/* 底部说明 */
.tip {
  margin-top: 34rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

/* 演示账号提示：极轻的一条，不抢视觉 */
.demo {
  margin-top: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 16rpx;
  border-top: 1rpx dashed var(--line);
}
.demo__t {
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: 0.08em;
}
.demo__v {
  font-size: 22rpx;
  color: var(--ink-3);
}
