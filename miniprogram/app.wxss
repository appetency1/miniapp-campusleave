/* ============================================================
 * app.wxss —— 全局设计令牌 + 基础件
 * 视觉基线：formal-v2（纸感体系）
 *   纸 #FBFAF7 / 墨 #15202E / 蓝 #2563C9 / 线 #E7E3D9，圆角 6，页边距 20px(40rpx)
 *
 * 小程序与 Web 的不同点：
 *   - 单位用 rpx（750rpx = 屏幕宽度），1px ≈ 2rpx（以 375 逻辑宽为基准）
 *   - 没有 :root，CSS 变量挂在 page 上，全局可用
 *   - 没有 hover，交互反馈用 .is-active / hover-class
 * ============================================================ */

page {
  /* ---- 色板（与 formal-v2 完全一致）---- */
  --paper: #FBFAF7;
  --paper-2: #F5F3EC;
  --surface: #FFFFFF;
  --ink: #15202E;
  --ink-2: #55606F;
  --ink-3: #6B6559;
  --ink-4: #8E887B;
  --line: #E7E3D9;
  --line-2: #D8D3C6;
  --blue-50: #EFF4FD;
  --blue-100: #DCE8FA;
  --blue-500: #2563C9;
  --blue-600: #1F55AD;
  --blue-700: #194089;
  --amber-600: #9A5B0B;
  --amber-50: #FDF3E3;
  --red-600: #B23A28;
  --red-50: #FBECE9;
  --teal-600: #0B7A6B;
  --teal-50: #E6F4F1;

  /* ---- 圆角 / 间距 ---- */
  --r: 12rpx;          /* = 6px */

  background: var(--paper);
  color: var(--ink);
  font-family: "Noto Sans SC", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* ------------------------------------------------------------
 * 字体
 * 数字、编号、时间用衬线体 —— 这是定稿的记忆点之一（刻度尺上的数字）
 * ------------------------------------------------------------ */
.num,
.mono {
  font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", Georgia, serif;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ------------------------------------------------------------
 * 布局
 * ------------------------------------------------------------ */
.page-pad {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

/* 1rpx 细线分区（定稿用细线替代卡片，只有记录页用卡片） */
.rule {
  height: 1rpx;
  background: var(--line);
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ------------------------------------------------------------
 * 区块标题：左侧小标题 + 右侧文字按钮
 * 对应定稿 .sec h2（12px 字号、字重 600、下方 15px 间距）
 * ------------------------------------------------------------ */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 30rpx 0 18rpx;
}
.sec__t {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.02em;
}
.sec__a {
  font-size: 24rpx;
  color: var(--ink-3);
}

/* ------------------------------------------------------------
 * 按钮
 * 定稿规则：主按钮墨色实心；蓝色只给状态、刻度尺、tab 选中
 *
 * 注意：小程序原生 <button> 自带灰底、圆角和 ::after 边框，
 * 必须显式清掉，否则会盖在我们的墨色实心样式外面形成"双框"。
 * ------------------------------------------------------------ */
button::after {
  border: none;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r);
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
  border: 1rpx solid var(--ink);
  background: var(--ink);
  color: #FCFBF8;
  transition: opacity 0.18s ease, transform 0.18s ease;
}
.btn--ghost {
  background: transparent;
  color: var(--ink);
}
.btn--plain {
  border-color: var(--line-2);
  background: transparent;
  color: var(--ink-2);
}
.btn.is-active {
  opacity: 0.86;
  transform: scale(0.995);
}
.btn--disabled {
  opacity: 0.45;
}

/* 文字按钮（撤回 / 取消 / 查看详情） */
.link-btn {
  font-size: 26rpx;
  color: var(--ink-2);
  padding: 8rpx 4rpx;
}
.link-btn--danger {
  color: var(--red-600);
}

/* ------------------------------------------------------------
 * 状态标签
 * 蓝=进行中，琥珀=待处理，红=逾期/驳回，青=已完成，灰=已关闭
 * ------------------------------------------------------------ */
.state {
  font-size: 22rpx;
  line-height: 1;
  letter-spacing: 0.06em;
  color: var(--blue-700);
}
.state--warn {
  color: var(--amber-600);
}
.state--danger {
  color: var(--red-600);
}
.state--done {
  color: var(--teal-600);
}
.state--muted {
  color: var(--ink-4);
}

/* 小色块标签（记录列表右侧） */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.chip--blue {
  background: var(--blue-50);
  color: var(--blue-700);
}
.chip--amber {
  background: var(--amber-50);
  color: var(--amber-600);
}
.chip--red {
  background: var(--red-50);
  color: var(--red-600);
}
.chip--teal {
  background: var(--teal-50);
  color: var(--teal-600);
}
.chip--grey {
  background: var(--paper-2);
  color: var(--ink-3);
}

/* ------------------------------------------------------------
 * 空态 / 提示条
 * ------------------------------------------------------------ */
.empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
}

.notice {
  padding: 20rpx 24rpx;
  border-radius: var(--r);
  background: var(--red-50);
  color: var(--red-600);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 底部安全区（tabBar 页面内容不被遮住） */
.tabbar-hold {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
