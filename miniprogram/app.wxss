/* ============================================================
 * app.wxss —— 全局设计令牌 + 基础件
 * 视觉基线：formal-v2（纸感体系）
 *   纸 #FBFAF7 / 墨 #15202E / 蓝 #2563C9 / 线 #E7E3D9，圆角 6，页边距 20px(40rpx)
 *
 * 小程序与 Web 的不同点：
 *   - 单位用 rpx（750rpx = 屏幕宽度），1px ≈ 2rpx（以 375 逻辑宽为基准）
 *   - 没有 :root，CSS 变量挂在 page 上，全局可用
 *   - 没有 hover，交互反馈用 .is-active / hover-class
 * ============================================================ */

page {
  /* ---- 色板（V2 精修：暖白纸感 + 深墨，状态色全面降饱和）----
   * 原则：所有彩色都压到低饱和，靠明度差和字重建立层级，不靠鲜艳夺目。
   * 状态语义：橄榄绿=进行中/已完成，暖棕=审批中，砖红=逾期/驳回。
   */
  --paper: #FAF9F6;
  --paper-2: #F4F2EC;
  --surface: #FFFFFF;
  --ink: #182331;
  --ink-2: #4A5450;
  --ink-3: #68706C;
  --ink-4: #9A9A93;
  --line: #E8E6DF;
  --line-2: #DEDBD2;
  --accent-50: #EDF1EC;
  --accent-100: #DCE4DE;
  --accent-500: #536B59;
  --accent-600: #455B4B;
  --accent-700: #374A3D;
  --amber-600: #A4773A;
  --amber-50: #F7F1E6;
  --red-600: #A85445;
  --red-50: #F6ECEA;
  --teal-600: #536B59;
  --teal-50: #EDF1EC;

  /* ---- 圆角 / 间距 ---- */
  --r: 12rpx;          /* = 6px，内容分区的方角基调 */
  --r-btn: 24rpx;      /* = 12px，按钮单独用更圆的角 */
  --r-card: 28rpx;     /* = 14px，卡片专用：比 --r 圆一档，但远不到胶囊 */

  background: var(--paper);
  color: var(--ink);
  font-family: "Noto Sans SC", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  /* 根字号 30rpx≈15.7pt。不要照抄设计稿的 12px —— Web 的 12px 到手机上相当于 12pt，
     比 iOS 正文 17pt 小三成，真机上会明显"字很小"。 */
  font-size: 30rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* ------------------------------------------------------------
 * 数字
 * 精修版去掉了衬线体：宋体/明朝体在真机小字号下发虚，
 * 且与"现代中文无衬线"的基调冲突。改为系统无衬线 + 等宽数字（tabular-nums），
 * 保证时间、日期、编号在列表里纵向对齐。
 * ------------------------------------------------------------ */
.num,
.mono {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  font-weight: 500;
}

/* ------------------------------------------------------------
 * 布局
 * ------------------------------------------------------------ */
.page-pad {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

/* 1rpx 细线分区（定稿用细线替代卡片，只有记录页用卡片） */
.rule {
  height: 1rpx;
  background: var(--line);
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ------------------------------------------------------------
 * 卡片
 * 使用范围有语义，不是"所有区块都套一层"：
 *   卡片 = **此刻正在发生的事**（当前请假 / 最近记录）；
 *   细线 = **清单与说明**（本学期概览 / 请假须知）。
 * 两套语言并存，卡片才有资格叫"重点"。
 *
 * 实测过的坑：纸底 #FAF9F6 与白面 #FFFFFF 的亮度对比只有 1.05:1，
 * 面差撑不起边界 —— 卡片的边界是「1rpx 线 + 极浅双层阴影」给的。
 * 谁要是把 border 去掉，卡片就消失了（这不是装饰，是结构）。
 * ------------------------------------------------------------ */
.card {
  position: relative;
  background: var(--surface);
  border: 1rpx solid var(--line-2);
  border-radius: var(--r-card);
  box-shadow:
    0 1rpx 2rpx rgba(24, 35, 49, 0.03),
    0 10rpx 28rpx rgba(24, 35, 49, 0.045);
  overflow: hidden;
}

/* ------------------------------------------------------------
 * 区块标题：左侧小标题 + 右侧文字按钮
 * 定稿 .sec h2 是 12px（Web 尺度），真机上抬到 30rpx≈15.7pt 才够读
 * ------------------------------------------------------------ */
.sec {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  /* 上 40 下 14：标题与内容要贴近，与上一段要拉开 */
  margin: 40rpx 0 14rpx;
}
.sec__t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.02em;
}
.sec__a {
  font-size: 30rpx;
  color: var(--ink-3);
}

/* ------------------------------------------------------------
 * 按钮
 * 定稿规则：主按钮墨色实心；蓝色只给状态、刻度尺、tab 选中
 *
 * 注意：小程序原生 <button> 自带灰底、圆角和 ::after 边框，
 * 必须显式清掉，否则会盖在我们的墨色实心样式外面形成"双框"。
 * ------------------------------------------------------------ */
button::after {
  border: none;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  /* 84rpx（≈44pt）：够拇指点，但不做"后台系统式"的大块按钮 */
  height: 84rpx;
  border-radius: var(--r-btn);
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
  /* 主按钮由墨色改为深橄榄：墨 #182331 的白字对比 15.6:1，
     橄榄 --accent-600 #455B4B 是 7.4:1 —— 仍远超 AA，但把"绿色的份量"
     从状态色扩展到了主操作上。不做设计稿那个 #557665（白字只 4.96:1）。 */
  border: 1rpx solid var(--accent-600);
  background: var(--accent-600);
  color: #FCFBF8;
  transition: opacity 0.18s ease, transform 0.18s ease;
}
/* 次级主按钮：白底 + 细边框 + 深色字。
   首页待审批态的「查看详情」用它 —— 此时用户的主诉求是"看一眼",
   不是"提交", 实心墨块会抢走状态词的注意力 */
.btn--ghost {
  background: var(--surface);
  border-color: var(--line-2);
  color: var(--ink);
}
.btn--plain {
  border-color: var(--line-2);
  background: transparent;
  color: var(--ink-2);
}
.btn.is-active {
  opacity: 0.86;
  transform: scale(0.995);
}
.btn--disabled {
  opacity: 0.45;
}

/* 文字按钮（撤回 / 取消 / 查看详情） */
.link-btn {
  font-size: 32rpx;
  color: var(--ink-2);
  padding: 8rpx 4rpx;
}
.link-btn--danger {
  color: var(--red-600);
}

/* ------------------------------------------------------------
 * 状态标签
 * 蓝=进行中，琥珀=待处理，红=逾期/驳回，青=已完成，灰=已关闭
 * ------------------------------------------------------------ */
.state {
  font-size: 28rpx;
  line-height: 1;
  letter-spacing: 0.06em;
  color: var(--accent-700);
}
.state--warn {
  color: var(--amber-600);
}
.state--danger {
  color: var(--red-600);
}
.state--done {
  color: var(--teal-600);
}
.state--muted {
  color: var(--ink-4);
}

/* 小色块标签（记录列表右侧） */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 28rpx;
  line-height: 1.4;
}
.chip--blue {
  background: var(--accent-50);
  color: var(--accent-700);
}
.chip--amber {
  background: var(--amber-50);
  color: var(--amber-600);
}
.chip--red {
  background: var(--red-50);
  color: var(--red-600);
}
.chip--teal {
  background: var(--teal-50);
  color: var(--teal-600);
}
.chip--grey {
  background: var(--paper-2);
  color: var(--ink-3);
}

/* ------------------------------------------------------------
 * 空态 / 提示条
 * ------------------------------------------------------------ */
.empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 32rpx;
}

.notice {
  padding: 20rpx 24rpx;
  border-radius: var(--r);
  background: var(--red-50);
  color: var(--red-600);
  font-size: 30rpx;
  line-height: 1.6;
}

/* 底部安全区（tabBar 页面内容不被遮住）
 * 数值必须与 custom-tab-bar/index.wxss 的 .tabbar 高度一致，否则留白对不上
 */
.tabbar-hold {
  height: calc(104rpx + env(safe-area-inset-bottom));
}
